# Первый запуск не требует этого файла: демонстрационный режим включён по умолчанию.
PORT=8080
LLM_MODE=demo
AUTH_MODE=demo
# Для настоящей модели скопируйте этот файл в .env и заполните ТОЛЬКО у себя.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Тарифы вашей модели, USD за миллион токенов. Без тарифов стоимость не оценена.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
# Необязательный локальный вход по личным токенам: AUTH_MODE=token.
# JSON: ключ — длинный случайный личный токен, значение — id сотрудника.
PERSON_TOKENS={}
